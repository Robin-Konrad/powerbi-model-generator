		summarizeBy: sum
		isNameInferred
		sourceColumn: [YearLabelAcademicSort]

		annotation SummarizationSetBy = Automatic

	partition _DateTable = calculated
		mode: import
		source = ```
				
				VAR MinYear = 2010
				VAR MaxYear = 2030
				VAR AcademicYearStartMonth = 10   
				RETURN
				ADDCOLUMNS(
				    CALENDAR(DATE(MinYear,1,1), DATE(MaxYear,12,31)),
				
				    "Year", YEAR([Date]),
				    "Year Start", DATE(YEAR([Date]),1,1),
				    "Year Label", "CY " & YEAR([Date]),
				    "YearLabelSort", YEAR([Date]),
				
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date],"MMMM"),
				    "Month Short", FORMAT([Date],"MMM"),
				    "Month Start", DATE(YEAR([Date]),MONTH([Date]),1),
				
				    "Day Name", FORMAT([Date],"dddd"),
				    "Day Short", FORMAT([Date],"ddd"),
				    "Is Weekend", WEEKDAY([Date],2) > 5,
				
				    "Week Number", WEEKNUM([Date],2),
				    "Week Start", [Date] - WEEKDAY([Date],2) + 1,
				
				    "Quarter", "Q" & FORMAT([Date],"Q"),
				    "Quarter Start", DATE(YEAR([Date]), (QUARTER([Date])-1)*3+1, 1),
				    "QuarterSort", YEAR([Date])*10 + QUARTER([Date]),
				
				    "Year-Month", FORMAT([Date],"YYYY-MM"),
				    "Year-Quarter", YEAR([Date]) & " Q" & FORMAT([Date],"Q"),
				
				    "Academic Year", IF(MONTH([Date]) >= AcademicYearStartMonth, YEAR([Date])+1, YEAR([Date])),
				    "Year Label (Academic)",
				        VAR AcadYr = IF(MONTH([Date]) >= AcademicYearStartMonth, YEAR([Date]), YEAR([Date])-1)
				        RETURN AcadYr & "-" & (AcadYr+1),
				    "YearLabelAcademicSort",
				        IF(MONTH([Date]) >= AcademicYearStartMonth, YEAR([Date]), YEAR([Date])-1)
				)
				```

	annotation PBI_Id = 523891a5920949e09d0bd1ad4d88d28f

